7e1-8a3b-4d83d2aaddb9")) (text "USB VBUS and the PoE module's 5 V meet on VSYS; D1 keeps PoE out of USB.\nTLV62569: VOUT = 0.6 V x (1 + R5/R6) = 3.33 V; 2.2 uH + 22 uF (TI table 4)." (exclude_from_sim no) (at 12 130.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ab26fce4-2d3c-5589-afb0-899bcd6a8343")) (rectangle (start 220 10) (end 405 135) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "1d17aabe-fadf-5407-b0f8-748febdb4b38")) (text "PoE: RJ45, magnetics, WIZPoE-P1 (isolated 802.3af)" (exclude_from_sim no) (at 222 15 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "8c633ca9-30ef-5787-92fb-671fcf619675")) (text "Mode A: T1 line centre taps -> VC1. Mode B: spare pairs 4/5, 7/8 -> VC2; U2 rectifies both.\nBob Smith: 75R + 10 nF/100 V per pair, 1 nF/2 kV to chassis. W5500 has no auto-MDIX: MDI.\nMDI side (J2, T1 pins 9-16, POE_*, BS*) keeps 2 mm from logic copper." (exclude_from_sim no) (at 222 128.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4bd71928-77de-5f6d-a7c4-8849d677c0b3")) (rectangle (start 410 10) (end 585 215) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "bcf3f0ae-5c3c-55bb-8716-0993c6ab4a3a")) (text "W5500 Ethernet (SPI0: GP16-GP21)" (exclude_from_sim no) (at 412 15 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "7273cafa-82dc-5477-a843-03dcb8521bf5")) (text "PMODE 111: auto-negotiation. Pin 23 RSVD to GND; TOCAP 4.7 uF; 1V2O 10 nF (datasheet v1.1.0).\nTX: 3.3R series, 49.9R to the 3V3A centre tap. RX: 6.8 nF coupling, 49.9R to C25." (exclude_from_sim no) (at 412 210.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ea93d06b-f192-58fd-882e-dfbbd80a09f4")) (rectangle (start 10 140) (end 260 330) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "5150169c-61ab-5850-99c0-8e756d848bb9")) (text "RP2040, flash, clock, USB, buttons, SWD" (exclude_from_sim no) (at 12 145 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "8e333e56-2051-5e8e-b8a6-ae986ff71b64")) (text "Raspberry Pi Pico core: 12 MHz crystal, W25Q16 2 MB flash, BOOTSEL on QSPI_SS.\nPin map unchanged (firmware board = pico): GP4/5 I2C0, GP16-21 W5500, GP22 factory reset,\nGP24 VBUS sense, GP25 status LED, GP27 MAINS_OK." (exclude_from_sim no) (at 12 323.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b1b5f4a2-64e0-5e04-9a75-527dbe93f78c")) (rectangle (start 265 140) (end 405 215) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "b4c2f5d0-b573-5ae1-9298-9f57d226b262")) (text "Ambient temperature, factory reset" (exclude_from_sim no) (at 267 145 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "57951195-b3d0-597f-a31c-9825c0e7d4ef")) (text "TMP1075 at 0x48 (A0-A2 to GND), placed away from U1, U3, U4.\nSW3: hold 10 s for factory reset." (exclude_from_sim no) (at 267 210.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2c7c265a-f3e1-5d8f-bf76-0690fba27f32")) (rectangle (start 265 220) (end 585 330) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "cffb2d44-e045-5b19-94b2-f0bb59c784be")) (text "Mains sense, 230 VAC (rev1 circuit, unchanged)" (exclude_from_sim no) (at 267 225 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "54f36449-3e95-5e1d-bd94-0c8b898832e8")) (text "DANGER 230 VAC: J4, F1, R33-R36, U6 inputs: 6.5 mm clearance, 6.4 mm creepage to everything else.\nU6 pulls SENSE low on both half cycles; C43/R37 bridge the zero crossings; U7 gives MAINS_OK (HIGH = mains)." (exclude_from_sim no) (at 267 325.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e5998493-0538-5939-b5af-7e7ae769604c")) (rectangle (start 10 335) (end 400 410) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "ea282ab2-d999-5cb4-bb13-e00a26dd77fd")) (text "Test pads, power flags, mounting holes" (exclude_from_sim no) (at 12 340 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left bottom)) (uuid "bb64415d-71e2-598d-ac66-7fd17223f0fc")) (text "Test pads 0.5 mm, from design/tests.json (aiflow test plan)." (exclude_from_sim no) (at 12 407.5 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "99313ebf-a377-50d2-a5f2-44a5e1184ecf")) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))
